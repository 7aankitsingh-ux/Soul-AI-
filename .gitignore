# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# ── SOUL-LLM generated artifacts (safe to rebuild) ─────────────
# Any trained weights anywhere in the repo
**/*.pt
soul-llm/checkpoints/
soul-llm/logs/
soul-llm/data/train.pt
soul-llm/data/val.pt
soul-llm/data/corpus*.txt
soul-llm/data/student_corpus.txt
# Distilled teacher data contains private conversations — never push
soul-llm/data/qwen_teacher.jsonl
soul-llm/data/collected/
soul-llm/data/processed/
soul-llm/data/teacher_generated/
soul-llm/tokenizer/vocab.json
soul-llm/data/raw/*
!soul-llm/data/raw/.gitkeep

# ── Runtime / local storage (user accounts, chats, sessions) ───
storage/
workspace/
logs/
*.log

# ── Misc local junk ────────────────────────────────────────────
.freebuff/
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
.idea/
.vscode/

# ── Environment / secrets ──────────────────────────────────────
.env
.env.local
*.key
*.pem